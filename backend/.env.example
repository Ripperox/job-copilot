# Copy to .env and fill in. Everything is optional — with no keys the app runs
# on sample jobs + heuristic scoring.

PORT=4500

# LLM for scoring + outreach (optional; without any, a keyword heuristic is used).
# Groq is free and fast — get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Anthropic works too (used only if Groq is not set).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ---- Job sources (all optional; with none, sample jobs are used) ----

# Adzuna — free keys at https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

# JSearch (RapidAPI) — aggregates Google for Jobs (LinkedIn, Indeed, Glassdoor…).
# Free tier at https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_RAPIDAPI_KEY=

# Active Jobs DB (200k+ career sites/ATS) + LinkedIn Job Search — both Fantastic.jobs
# on RapidAPI. Subscribe to each (free tier); they reuse JSEARCH_RAPIDAPI_KEY by
# default, so you usually don't need to set these explicitly.
ACTIVE_JOBS_RAPIDAPI_KEY=
LINKEDIN_JOBS_RAPIDAPI_KEY=

# Jooble — strong India coverage. Free key at https://jooble.org/api/about
JOOBLE_API_KEY=

# Company boards (no key needed) — comma-separated.
# Greenhouse board tokens, e.g. "ramp,stripe"; Lever company slugs, e.g. "netflix"
GREENHOUSE_BOARDS=
LEVER_BOARDS=
