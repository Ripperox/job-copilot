# Copy to .env and fill in. Everything is optional — with no keys the app runs
# on sample jobs + heuristic scoring.

PORT=4500

# LLM relevance scoring (optional). Without this, a keyword heuristic is used.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Adzuna job search (optional). Without this, sample jobs are used.
# Free keys at https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
