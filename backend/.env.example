# Copy to .env and fill in. Everything is optional — with no keys the app runs
# on sample jobs + heuristic scoring.

PORT=4500

# How often the backend auto-fetches jobs from all sources, in minutes.
# Default 60 (hourly). Set to 0 to disable auto-fetch and only fetch on demand.
# Note: hourly ≈ 720 runs/month — watch free-tier quotas (esp. Adzuna).
FETCH_INTERVAL_MINUTES=60

# LLM for scoring + outreach (optional; without any, a keyword heuristic is used).
# Groq is free and fast — get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Anthropic works too (used only if Groq is not set).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Google Gemini — free tier has the most generous quota (1M TPM, ~1500 req/day),
# so it's PREFERRED over Groq/Anthropic when set. Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ---- Job sources (all optional; with none, sample jobs are used) ----

# Adzuna — free keys at https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

# JSearch (RapidAPI) — aggregates Google for Jobs (LinkedIn, Indeed, Glassdoor…).
# Free tier at https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_RAPIDAPI_KEY=

# Active Jobs DB (200k+ career sites/ATS) + LinkedIn Job Search — both Fantastic.jobs
# on RapidAPI. Subscribe to each (free tier); they reuse JSEARCH_RAPIDAPI_KEY by
# default, so you usually don't need to set these explicitly.
ACTIVE_JOBS_RAPIDAPI_KEY=
LINKEDIN_JOBS_RAPIDAPI_KEY=

# Jooble — strong India coverage. Free key at https://jooble.org/api/about
JOOBLE_API_KEY=

# Company boards (no key needed) — comma-separated.
# Greenhouse board tokens, e.g. "ramp,stripe"; Lever company slugs, e.g. "netflix"
GREENHOUSE_BOARDS=
LEVER_BOARDS=

# PostgreSQL. Local dev default: postgres://localhost:5432/jobcopilot
DATABASE_URL=postgres://localhost:5432/jobcopilot
# Used only by `npm test`. Must be a DIFFERENT database — tests TRUNCATE it.
TEST_DATABASE_URL=postgres://localhost:5432/jobcopilot_test

# ---- Web scraping: company career pages (the low-competition source) ----
# Tried in this order; the chain falls through when one runs out of quota.
# Jina needs no key at all, so there is always a last resort.
FIRECRAWL_API_KEY=      # 1000 free pages/month — firecrawl.dev
TAVILY_API_KEY=         # tavily.com
EXA_API_KEY=            # exa.ai
JINA_API_KEY=           # optional; r.jina.ai works keyless at lower limits
# Comma-separated career pages to scrape for openings.
SCRAPE_CAREER_PAGES=
